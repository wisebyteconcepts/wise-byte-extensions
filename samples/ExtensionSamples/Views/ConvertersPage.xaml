<Page
    x:Class="ExtensionSamples.Views.ConvertersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:ExtensionSamples.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ExtensionSamples.ViewModels"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="{Binding}"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    d:DataContext="{d:DesignInstance Type=viewmodel:ConvertersViewModel}"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid
            x:Name="ContentArea"
            Margin="38"
            ColumnSpacing="32"
            RowSpacing="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  Two State Boolean Converter  -->
            <StackPanel Style="{StaticResource CardPanelStyle}">

                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Two State Boolean Converter" />
                <MenuFlyoutSeparator />

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="User Interface" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="True" IsChecked="{Binding TwoStateBoolean, Converter={StaticResource BooleanToSelectionConverter}, ConverterParameter='True', Mode=TwoWay}" />
                            <RadioButton Content="False" IsChecked="{Binding TwoStateBoolean, Converter={StaticResource BooleanToSelectionConverter}, ConverterParameter='False', Mode=TwoWay}" />
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Viewmodel" />
                        <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{Binding TwoStateBoolean, Mode=OneWay}" />
                        <Button
                            Margin="0,8,0,0"
                            Command="{Binding CheckTwoStateBooleanCommand}"
                            Content="Check ViewModel Value" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Three State Boolean Converter  -->
            <StackPanel Grid.Column="1" Style="{StaticResource CardPanelStyle}">

                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Three State Boolean Converter" />
                <MenuFlyoutSeparator />

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="User Interface" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="True" IsChecked="{Binding ThreeStateBoolean, Converter={StaticResource ThreeStateBooleanToSelectionConverter}, ConverterParameter='True', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Content="False" IsChecked="{Binding ThreeStateBoolean, Converter={StaticResource ThreeStateBooleanToSelectionConverter}, ConverterParameter='False', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Content="Null" IsChecked="{Binding ThreeStateBoolean, Converter={StaticResource ThreeStateBooleanToSelectionConverter}, ConverterParameter='Null', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Viewmodel" />
                        <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{Binding ThreeStateBooleanText}" />
                        <Button
                            Margin="0,8,0,0"
                            Command="{Binding CheckThreeStateBooleanCommand}"
                            Content="Check ViewModel Value" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Two State Boolean to Text Converter  -->
            <StackPanel Grid.Row="1" Style="{StaticResource CardPanelStyle}">

                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Two State Boolean to Text Converter" />
                <MenuFlyoutSeparator />

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="ViewModel" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding TwoStateBooleanSwitcherForTextCommand}"
                                CommandParameter="true"
                                Content="True" />

                            <Button
                                Command="{Binding TwoStateBooleanSwitcherForTextCommand}"
                                CommandParameter="False"
                                Content="False" />

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="User Interface" />
                        <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{Binding TwoStateBooleanForText, Mode=OneWay, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='TrueValue|FalseValue'}" />
                    </StackPanel>
                </StackPanel>

                <TextBox Text="{Binding TwoStateBooleanForText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='TrueValue|FalseValue'}" />

            </StackPanel>

            <!--  Three State Boolean to Text Converter  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource CardPanelStyle}">

                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Three State Boolean to Text Converter" />
                <MenuFlyoutSeparator />

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="ViewModel" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding ThreeStateBooleanSwitcherForTextCommand}"
                                CommandParameter="true"
                                Content="True" />

                            <Button
                                Command="{Binding ThreeStateBooleanSwitcherForTextCommand}"
                                CommandParameter="False"
                                Content="False" />
                            <Button
                                Command="{Binding ThreeStateBooleanSwitcherForTextCommand}"
                                CommandParameter="Null"
                                Content="Null" />

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="User Interface" />
                        <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{Binding ThreeStateBooleanForText, Converter={StaticResource ThreeStateBooleanToTextConverter}, Mode=OneWay, ConverterParameter='TrueValue|FalseValue|NullValue'}" />
                    </StackPanel>
                </StackPanel>

                <TextBox Text="{Binding ThreeStateBooleanForText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThreeStateBooleanToTextConverter}, ConverterParameter='TrueValue|FalseValue|NullValue'}" />


            </StackPanel>


            <!--  Two State Boolean to Brush Converter  -->
            <StackPanel Grid.Row="2" Style="{StaticResource CardPanelStyle}">

                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Two State Boolean to Brush Converter" />
                <MenuFlyoutSeparator />

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="ViewModel" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding TwoStateBooleanSwitcherForBrushCommand}"
                                CommandParameter="true"
                                Content="True" />

                            <Button
                                Command="{Binding TwoStateBooleanSwitcherForBrushCommand}"
                                CommandParameter="False"
                                Content="False" />

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="User Interface" />


                        <Border
                            Padding="8,6,8,8"
                            HorizontalAlignment="Left"
                            Background="{Binding TwoStateBooleanForBrush, Converter={StaticResource BooleanToResourceBrushConverter}, Mode=OneWay, ConverterParameter='SystemFillColorSuccessBackgroundBrush|SystemFillColorCriticalBackgroundBrush'}"
                            CornerRadius="4">
                            <TextBlock Foreground="{Binding TwoStateBooleanForBrush, Converter={StaticResource BooleanToResourceBrushConverter}, Mode=OneWay, ConverterParameter='SystemFillColorSuccessBrush|SystemFillColorCriticalBrush'}" Text="{Binding TwoStateBooleanForBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='True|False'}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

            </StackPanel>

            <!--  Three State Boolean to Brush Converter  -->
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Style="{StaticResource CardPanelStyle}">

                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Three State Boolean to Brush Converter" />
                <MenuFlyoutSeparator />

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="ViewModel" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding ThreeStateBooleanSwitcherForBrushCommand}"
                                CommandParameter="true"
                                Content="True" />

                            <Button
                                Command="{Binding ThreeStateBooleanSwitcherForBrushCommand}"
                                CommandParameter="False"
                                Content="False" />
                            <Button
                                Command="{Binding ThreeStateBooleanSwitcherForBrushCommand}"
                                CommandParameter="Null"
                                Content="Null" />

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="User Interface" />
                        <Border
                            Padding="8,6,8,8"
                            HorizontalAlignment="Left"
                            Background="{Binding ThreeStateBooleanForBrush, Converter={StaticResource ThreeStateBooleanToResourceBrushConverter}, Mode=OneWay, ConverterParameter='SystemFillColorSuccessBackgroundBrush|SystemFillColorCriticalBackgroundBrush|AccentAcrylicBackgroundFillColorDefaultBrush'}"
                            CornerRadius="4">
                            <TextBlock Foreground="{Binding ThreeStateBooleanForBrush, Converter={StaticResource ThreeStateBooleanToResourceBrushConverter}, Mode=OneWay, ConverterParameter='SystemFillColorSuccessBrush|SystemFillColorCriticalBrush|AccentTextFillColorSecondaryBrush'}" Text="{Binding ThreeStateBooleanForBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThreeStateBooleanToTextConverter}, ConverterParameter='True|False|Null'}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>


        </Grid>
    </ScrollViewer>
</Page>
