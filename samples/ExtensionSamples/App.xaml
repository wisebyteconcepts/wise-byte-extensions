<Application
    x:Class="ExtensionSamples.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WiseByteExtensions.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
                <ResourceDictionary Source="/Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToSelectionConverter x:Key="BooleanToSelectionConverter" />
            <converters:ThreeStateBooleanToSelectionConverter x:Key="ThreeStateBooleanToSelectionConverter" />
            <converters:BooleanToTextConverter x:Key="BooleanToTextConverter" />
            <converters:ThreeStateBooleanToTextConverter x:Key="ThreeStateBooleanToTextConverter" />
            <converters:BooleanToResourceBrushConverter x:Key="BooleanToResourceBrushConverter" />
            <converters:ThreeStateBooleanToResourceBrushConverter x:Key="ThreeStateBooleanToResourceBrushConverter" />
            <converters:NumericValueToStringConverter x:Key="NumericValueToStringConverter" />
            <converters:ValueTypeNameConverter x:Key="ValueTypeNameConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
