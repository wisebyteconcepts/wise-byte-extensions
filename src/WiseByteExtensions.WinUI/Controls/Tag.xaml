<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WiseByteExtensions.WinUI.Controls.Tag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WiseByteExtensions.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:Tag}"
    mc:Ignorable="d">

    <Border
        x:Name="RootBorder"
        Padding="8,2,8,3"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{Binding BackgroundColor}"
        CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Icon  -->
            <ContentControl
                x:Name="IconPresenter"
                Margin="0,0,8,0"
                Content="{Binding Icon}"
                Foreground="{Binding IconColor}">
                <ContentControl.Resources>
                    <!--  Style all IconElements inside  -->
                    <Style TargetType="IconElement">
                        <Setter Property="Width" Value="{Binding IconSize, Mode=OneWay}" />
                        <Setter Property="Height" Value="{Binding IconSize, Mode=OneWay}" />
                        <Setter Property="Foreground" Value="{Binding IconColor, Mode=OneWay}" />
                    </Style>
                </ContentControl.Resources>
            </ContentControl>
            <!--  Prefix  -->
            <TextBlock
                x:Name="PrefixText"
                Grid.Column="1"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{Binding PrefixColor}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding Prefix}" />
            <!--  Main Text  -->
            <TextBlock
                x:Name="MainText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="{StaticResource CaptionTextBlockFontSize}"
                Foreground="{Binding TextColor}"
                Style="{StaticResource BaseTextBlockStyle}"
                Text="{Binding Text}" />
            <!--  Suffix  -->
            <TextBlock
                x:Name="SuffixText"
                Grid.Column="3"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource CaptionTextBlockFontSize}"
                Foreground="{Binding SuffixColor}"
                Text="{Binding Suffix}" />
        </Grid>
    </Border>
</UserControl>
